# Copie este arquivo para .env (ou exporte as variáveis no seu ambiente/host)
# e NUNCA commite o .env real. O antigo jwt.secret hardcoded em
# application.properties foi removido por estar exposto no repositório público.

# Gere um valor novo e forte, por exemplo:
#   openssl rand -base64 48
JWT_SECRET=troque-por-um-valor-aleatorio-de-pelo-menos-32-bytes

# Necessárias apenas no profile "prod" (application-prod.properties)
DATABASE_URL=jdbc:postgresql://host:5432/dbname
DATABASE_USERNAME=
DATABASE_PASSWORD=
FRONTEND_URL=https://seu-dominio.com
MAIL_USERNAME=
MAIL_PASSWORD=
